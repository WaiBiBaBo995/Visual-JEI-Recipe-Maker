{
  "schemaVersion": 1,
  "id": "vjrm",
  "version": "${version}",
  "name": "Visual JEI Recipe Maker",
  "description": "In-game datapack recipe editor with native recipe previews.",
  "authors": [
    "PureNeko"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.pureneko.vjrm.Vjrm"
    ],
    "client": [
      "com.pureneko.vjrm.client.VjrmClient"
    ],
    "jei_mod_plugin": [
      "com.pureneko.vjrm.client.VjrmJeiPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*"
  },
  "breaks": {
    "jei": "<29.47.0.111"
  }
}
